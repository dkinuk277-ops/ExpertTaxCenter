{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "experttaxcenter",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Plain settings live here so deploys never wipe them. Secret (RESEND_API_KEY) stay in the Cloudflare dashboard.
  "vars": {
    "TO_EMAIL": "hellocompsilon@gmail.com",
    "FROM_EMAIL": "Expert Tax Center <enquiry@experttaxcenter.com>",
    "SITE_URL": "https://www.experttaxcenter.com"
  },
  // Don't delete any extra variables added in the dashboard on deploy
  "keep_vars": true
}
